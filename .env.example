# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Database + Auth) ---
# Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses Row-Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# "Continue with Google" is configured as a provider inside the Supabase
# dashboard (Authentication > Providers > Google) using your own Google
# OAuth Client ID/Secret — it is not read from env vars here.

# --- Background jobs / queue (BullMQ) ---
# Upstash Redis (or any Redis-compatible) connection string.
REDIS_URL=

# --- AI text generation ---
ANTHROPIC_API_KEY=

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Transactional email (Nodemailer) ---
# Used for password resets and system notifications. Per-organization
# campaign sender accounts are connected in-app (Sender Settings), not here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
